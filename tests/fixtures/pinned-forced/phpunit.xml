<?xml version="1.0" encoding="UTF-8"?>
<!-- The one shape that genuinely defeats a shell override. PhpHandler: if ($force || getenv($name)
     === false) { putenv(...) } — the force branch is unconditional. -->
<phpunit bootstrap="vendor/autoload.php">
    <php>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="pinned_hard" force="true"/>
    </php>
</phpunit>
