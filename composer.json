{
    "name": "splicewire/laravel-beam-dev",
    "description": "Developer tooling for the Beam family, require-dev and never shipped. Session-scoped scratch databases so concurrent suites stop clobbering each other \u2014 created, provisioned from SQL before the first migration, and reaped behind guards that refuse production, the app's own database, and any database another run is still connected to. Plus the wire-name reader that proves a DTO property rename moved no published key.",
    "keywords": [
        "laravel",
        "testing",
        "database",
        "postgres",
        "mysql",
        "sqlite",
        "developer-tools",
        "splicewire",
        "beam"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Dev\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Dev\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Dev\\BeamDevServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    }
}
